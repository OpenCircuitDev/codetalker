{
  "name": "claude-code-talker-vscode",
  "displayName": "Claude Code Talker",
  "description": "Voice companion for Claude Code — status bar + Open Web UI",
  "version": "0.2.0",
  "publisher": "OpenCircuitDev",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "type": "commonjs",
  "contributes": {
    "commands": [
      { "command": "claude-tts.toggle",      "title": "Claude TTS: Toggle Mute" },
      { "command": "claude-tts.openWebUI",   "title": "Claude TTS: Open Web UI" }
    ],
    "configuration": {
      "title": "Claude Code Talker",
      "properties": {
        "claudeTts.daemonHost":              { "type": "string",  "default": "127.0.0.1" },
        "claudeTts.daemonPort":              { "type": "number",  "default": 17832 },
        "claudeTts.statusBarPollIntervalMs": { "type": "number",  "default": 2000 },
        "claudeTts.autoSpawnDaemon":         { "type": "boolean", "default": true }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
